def setup_logging(
    log_dir: str = r"{{ config.output_dir }}logs",
    verbose: bool = {{ output.verbose | lower }},
    log_name: str = "autoeval",
) -> logging.Logger:
    """
    配置并返回统一日志记录器。

    同时输出到控制台（stdout）与带时间戳的日志文件。

    Parameters
    ----------
    log_dir  : 日志文件保存目录
    verbose  : True → DEBUG 级别；False → INFO 级别
    log_name : 日志器名称，避免与其他模块冲突

    Returns
    -------
    logging.Logger 实例
    """
    os.makedirs(log_dir, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    log_path = os.path.join(log_dir, f"{log_name}_{ts}.log")

    level = logging.DEBUG if verbose else logging.INFO
    fmt = "%(asctime)s [%(levelname)-8s] %(message)s"
    date_fmt = "%H:%M:%S"

    # 防止重复添加 handler（在 Jupyter / 重载场景中常见）
    logger = logging.getLogger(log_name)
    logger.setLevel(level)
    if not logger.handlers:
        # 文件 handler（UTF-8 支持中文）
        fh = logging.FileHandler(log_path, encoding="utf-8")
        fh.setLevel(level)
        fh.setFormatter(logging.Formatter(fmt, date_fmt))
        # 控制台 handler
        ch = logging.StreamHandler(sys.stdout)
        ch.setLevel(level)
        ch.setFormatter(logging.Formatter(fmt, date_fmt))
        logger.addHandler(fh)
        logger.addHandler(ch)

    logger.info("日志已初始化 → %s", log_path)
    return logger


