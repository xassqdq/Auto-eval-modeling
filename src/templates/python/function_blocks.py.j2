def print_section(title: str, char: str = "═", width: int = 62) -> None:
    """打印带双线分隔的节标题，提升脚本可读性。"""
    border = char * width
    print(f"\n{border}")
    print(f"  {title}")
    print(f"{border}")


def print_step(step_num: int, title: str, total: Optional[int] = None) -> None:
    """打印带步骤编号的子节标题。"""
    suffix = f"/{total}" if total else ""
    print(f"\n{'─' * 62}")
    print(f"  [Step {step_num}{suffix}]  ▶  {title}")
    print(f"{'─' * 62}")


def print_weights_table(
    weights: np.ndarray,
    indicator_names: List[str],
    method_name: str = "",
    logger: Optional[logging.Logger] = None,
) -> None:
    """
    格式化打印权重向量表格（含权重值与百分比）。

    Parameters
    ----------
    weights        : 权重数组，shape = (n_indicators,)
    indicator_names: 指标名称列表
    method_name    : 赋权方法名称（用于标题）
    """
    label = f"权重结果（{method_name}）" if method_name else "权重结果"
    print(f"\n  {label}:")
    w_df = pd.DataFrame({
        "指标":   indicator_names,
        "权重":   [f"{w:.6f}" for w in weights],
        "占比%":  [f"{w * 100:.2f}%" for w in weights],
    })
    print(w_df.to_string(index=False, justify="center"))
    print(f"  {'─'*40}")
    print(f"  权重合计: {weights.sum():.6f}  (应≈1.0)")


def print_ranking_table(
    objects: np.ndarray,
    scores: np.ndarray,
    method_name: str = "综合评价",
    ascending: bool = False,
    logger: Optional[logging.Logger] = None,
) -> pd.DataFrame:
    """
    格式化打印评价排名结果，返回排名 DataFrame。

    Parameters
    ----------
    objects    : 评价对象名称数组
    scores     : 综合得分数组（越大越好，ascending=False）
    method_name: 评价方法名称
    ascending  : True → 分数越小排名越高（如 VIKOR 的 Q 值）

    Returns
    -------
    pd.DataFrame : 包含排名、对象名、得分的整理结果
    """
    sort_idx = np.argsort(scores) if ascending else np.argsort(scores)[::-1]
    rank_df = pd.DataFrame({
        "排名":            range(1, len(objects) + 1),
        "评价对象":        [objects[i] for i in sort_idx],
        f"{method_name}得分": [f"{scores[i]:.4f}" for i in sort_idx],
    })
    print(f"\n  {method_name} — 排名结果:")
    print(rank_df.to_string(index=False, justify="center"))
    return rank_df


