# ================================================================

def plot_weights_bar(
    weights: np.ndarray,
    indicator_names: List[str],
    method_name: str = "权重",
    save_path: Optional[str] = None,
    show: bool = SHOW_PLOTS,
) -> plt.Figure:
    """
    绘制权重条形图（水平排列，按权重大小降序）。

    Returns
    -------
    matplotlib Figure 对象
    """
    sort_idx = np.argsort(weights)
    sorted_names   = [indicator_names[i] for i in sort_idx]
    sorted_weights = weights[sort_idx]

    fig, ax = plt.subplots(figsize=(8, max(4, len(weights) * 0.5)))
    bars = ax.barh(sorted_names, sorted_weights, color=sns.color_palette("Blues_d", len(weights)))
    ax.set_xlabel("权重值", fontsize=12)
    ax.set_title(f"{method_name} — 指标权重分布", fontsize=14, fontweight="bold")

    # 数据标签
    for bar, val in zip(bars, sorted_weights):
        ax.text(
            val + 0.002, bar.get_y() + bar.get_height() / 2,
            f"{val:.4f}", va="center", fontsize=9,
        )
    ax.axvline(x=1.0 / len(weights), color="red", linestyle="--",
               alpha=0.6, label=f"均匀权重 {1/len(weights):.4f}")
    ax.legend(fontsize=9)
    plt.tight_layout()
    if save_path:
        save_figure(fig, Path(save_path).stem, str(Path(save_path).parent))
    if show:
        plt.show()
    return fig


def plot_ranking_bar(
    scores: np.ndarray,
    objects: np.ndarray,
    method_name: str = "综合评价",
    save_path: Optional[str] = None,
    show: bool = SHOW_PLOTS,
    ascending: bool = False,
) -> plt.Figure:
    """
    绘制综合得分排名条形图（竖排，按排名由高到低）。
    """
    sort_idx = np.argsort(scores)[::-1] if not ascending else np.argsort(scores)
    sorted_objs   = [str(objects[i]) for i in sort_idx]
    sorted_scores = scores[sort_idx]
    n = len(objects)
    palette = sns.color_palette("RdYlGn_r" if ascending else "RdYlGn", n)
    colors = palette[::-1] if not ascending else palette

    fig, ax = plt.subplots(figsize=(max(6, n * 0.9), 5))
    bars = ax.bar(sorted_objs, sorted_scores, color=colors, edgecolor="white", linewidth=0.8)
    ax.set_xlabel("评价对象", fontsize=12)
    ax.set_ylabel("综合得分", fontsize=12)
    ax.set_title(f"{method_name} — 综合评价排名", fontsize=14, fontweight="bold")

    for bar, val in zip(bars, sorted_scores):
        ax.text(
            bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.005,
            f"{val:.3f}", ha="center", va="bottom", fontsize=9,
        )
    ax.set_ylim(0, sorted_scores.max() * 1.15)
    plt.xticks(rotation=30, ha="right")
    plt.tight_layout()
    if save_path:
        save_figure(fig, Path(save_path).stem, str(Path(save_path).parent))
    if show:
        plt.show()
    return fig


def plot_radar(
    data_matrix_norm: np.ndarray,
    indicator_names: List[str],
    objects: np.ndarray,
    top_n: int = 5,
    save_path: Optional[str] = None,
    show: bool = SHOW_PLOTS,
) -> plt.Figure:
    """
    绘制雷达图（展示排名前 top_n 个评价对象的指标分布）。

    Parameters
    ----------
    top_n : 展示对象数（默认前 5 个，超过 8 个时图形会拥挤）
    """
    n_ind = len(indicator_names)
    angles = np.linspace(0, 2 * np.pi, n_ind, endpoint=False).tolist()
    angles += angles[:1]   # 闭合

    fig, ax = plt.subplots(figsize=(7, 7), subplot_kw={"polar": True})
    palette = sns.color_palette("tab10", min(top_n, len(objects)))

    for i in range(min(top_n, len(objects))):
        values = data_matrix_norm[i].tolist() + data_matrix_norm[i][:1].tolist()
        ax.plot(angles, values, "o-", linewidth=1.5, color=palette[i], label=str(objects[i]))
        ax.fill(angles, values, alpha=0.10, color=palette[i])

    ax.set_xticks(angles[:-1])
    ax.set_xticklabels(indicator_names, fontsize=10)
    ax.set_title(f"综合评价指标雷达图（Top {top_n}）", fontsize=13, fontweight="bold", pad=20)
    ax.legend(loc="upper right", bbox_to_anchor=(1.25, 1.1), fontsize=9)
    plt.tight_layout()
    if save_path:
        save_figure(fig, Path(save_path).stem, str(Path(save_path).parent))
    if show:
        plt.show()
    return fig


def plot_correlation_heatmap(
    data_matrix: np.ndarray,
    indicator_names: List[str],
    save_path: Optional[str] = None,
    show: bool = SHOW_PLOTS,
) -> plt.Figure:
    """
    绘制指标相关性热力图（用于判断是否需要降维）。
    """
    corr_df, _ = correlation_matrix(data_matrix, indicator_names)
    mask = np.triu(np.ones_like(corr_df, dtype=bool), k=1)

    fig, ax = plt.subplots(figsize=(max(6, len(indicator_names)), max(5, len(indicator_names) * 0.8)))
    sns.heatmap(
        corr_df, mask=~mask, annot=True, fmt=".2f",
        cmap="coolwarm", center=0, vmin=-1, vmax=1,
        square=True, linewidths=0.5, ax=ax,
        annot_kws={"size": 8},
    )
    ax.set_title("指标相关系数矩阵", fontsize=13, fontweight="bold")
    plt.tight_layout()
    if save_path:
        save_figure(fig, Path(save_path).stem, str(Path(save_path).parent))
    if show:
        plt.show()
    return fig


{% if use_sensitivity %}
def plot_sensitivity_curves(
    score_df: pd.DataFrame,
    objects: np.ndarray,
    indicator_names: List[str],
    method_name: str = "TOPSIS",
    save_path: Optional[str] = None,
    show: bool = SHOW_PLOTS,
) -> plt.Figure:
    """
    绘制灵敏度分析折线图。

    为每个指标的扰动画一个子图，展示各评价对象得分随权重变化的趋势。
    """
    n_ind = len(indicator_names)
    n_cols = min(3, n_ind)
    n_rows = (n_ind + n_cols - 1) // n_cols

    fig, axes = plt.subplots(n_rows, n_cols, figsize=(n_cols * 5, n_rows * 4))
    axes = np.array(axes).flatten()

    palette = sns.color_palette("tab10", len(objects))
    obj_strs = [str(o) for o in objects]

    for idx, ind_name in enumerate(indicator_names):
        ax = axes[idx]
        sub_df = score_df[score_df["指标"] == ind_name].sort_values("扰动因子")

        for i, obj in enumerate(obj_strs):
            if obj in sub_df.columns:
                ax.plot(
                    sub_df["扰动因子"], sub_df[obj],
                    marker=".", linewidth=1.5, color=palette[i],
                    label=obj if idx == 0 else "_nolegend_",
                )
        ax.axvline(x=1.0, color="gray", linestyle="--", alpha=0.6)
        ax.set_title(f"扰动指标: {ind_name}", fontsize=10)
        ax.set_xlabel("扰动因子", fontsize=9)
        ax.set_ylabel(f"{method_name}得分", fontsize=9)
        ax.tick_params(labelsize=8)

    # 隐藏多余子图
    for idx in range(n_ind, len(axes)):
        axes[idx].set_visible(False)

    # 统一图例
    handles = [
        plt.Line2D([0], [0], color=palette[i], linewidth=2, label=obj_strs[i])
        for i in range(len(obj_strs))
    ]
    fig.legend(handles=handles, loc="lower center",
               ncol=min(6, len(obj_strs)), fontsize=9,
               bbox_to_anchor=(0.5, -0.02))
    fig.suptitle(f"权重灵敏度分析（{method_name}）", fontsize=14, fontweight="bold")
    plt.tight_layout(rect=[0, 0.04, 1, 0.96])
    if save_path:
        save_figure(fig, Path(save_path).stem, str(Path(save_path).parent))
    if show:
        plt.show()
    return fig
{% endif %}


{% if use_multiple_models %}
def plot_method_comparison(
    results_dict: Dict[str, np.ndarray],
    objects: np.ndarray,
    save_path: Optional[str] = None,
    show: bool = SHOW_PLOTS,
) -> plt.Figure:
    """
    绘制多评价方法排名对比热力图。

    Parameters
    ----------
    results_dict : {方法名: 排名数组} dict
    """
    ranks_dict = {}
    for method, scores in results_dict.items():
        ranks_dict[method] = pd.Series(scores).rank(ascending=False).astype(int).values

    rank_df = pd.DataFrame(ranks_dict, index=[str(o) for o in objects])
    fig, ax = plt.subplots(figsize=(max(6, len(ranks_dict) * 1.5), max(4, len(objects) * 0.6)))
    sns.heatmap(
        rank_df, annot=True, fmt="d", cmap="YlOrRd_r",
        linewidths=0.5, ax=ax, annot_kws={"size": 10},
    )
    ax.set_title("多方法评价排名对比", fontsize=13, fontweight="bold")
    ax.set_xlabel("评价方法", fontsize=11)
    ax.set_ylabel("评价对象", fontsize=11)
    plt.tight_layout()
    if save_path:
        save_figure(fig, Path(save_path).stem, str(Path(save_path).parent))
    if show:
        plt.show()
    return fig
