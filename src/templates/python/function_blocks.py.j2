def save_dataframe(
    df: pd.DataFrame,
    filename: str,
    output_dir: str,
    index: bool = True,
    logger: Optional[logging.Logger] = None,
) -> str:
    """
    将 DataFrame 保存为 CSV（使用 utf-8-sig，Excel 可直接打开中文）。

    Returns
    -------
    str : 保存文件的绝对路径
    """
    os.makedirs(output_dir, exist_ok=True)
    # 自动补充扩展名
    if not filename.endswith(".csv"):
        filename = filename + ".csv"
    filepath = os.path.join(output_dir, filename)
    df.to_csv(filepath, index=index, encoding="utf-8-sig")
    msg = f"  📄 表格已保存 → {filepath}"
    (logger.info if logger else print)(msg)
    return os.path.abspath(filepath)


def save_figure(
    fig,
    filename: str,
    figures_dir: str,
    dpi: int = {{ config.fig_dpi }},
    fmt: str = "{{ config.fig_format }}",
    logger: Optional[logging.Logger] = None,
) -> str:
    """
    保存 matplotlib Figure 到指定目录。

    Parameters
    ----------
    fig         : matplotlib Figure 对象
    filename    : 文件名（不含扩展名时自动添加）
    figures_dir : 图片保存目录
    dpi         : 输出分辨率（默认 {{ config.fig_dpi }} DPI）
    fmt         : 格式，{{ config.fig_format }} / pdf / svg 等

    Returns
    -------
    str : 保存文件的绝对路径
    """
    import matplotlib.pyplot as plt
    os.makedirs(figures_dir, exist_ok=True)
    # 确保扩展名正确
    stem = Path(filename).stem
    filepath = os.path.join(figures_dir, f"{stem}.{fmt}")
    fig.savefig(filepath, dpi=dpi, bbox_inches="tight", facecolor="white")
    plt.close(fig)
    msg = f"  🖼  图片已保存 → {filepath}"
    (logger.info if logger else print)(msg)
    return os.path.abspath(filepath)


