{% if use_topsis %}
def topsis(
    X_norm: np.ndarray,
    weights: np.ndarray,
    objects: np.ndarray,
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, pd.DataFrame]:
    """
    TOPSIS（Technique for Order Preference by Similarity to Ideal Solution）。

    数学步骤
    --------
    1. 加权规范化矩阵：V = X_norm · diag(w)
    2. 正理想解：V⁺_j = max_i(V_ij)
       负理想解：V⁻_j = min_i(V_ij)
    3. 欧氏距离：D⁺_i = ||V_i - V⁺||₂，D⁻_i = ||V_i - V⁻||₂
    4. 相对贴近度：C_i = D⁻_i / (D⁺_i + D⁻_i)，越大越优

    Returns
    -------
    scores     : 相对贴近度数组，shape=(n_objects,)
    result_df  : 含 D+、D-、贴近度、排名的结果 DataFrame
    """
    _log = logger.info if logger else print

    # —— Step 1: 加权矩阵 ——
    V = X_norm * weights[np.newaxis, :]

    # —— Step 2: 理想解 ——
    V_pos = V.max(axis=0)   # 正理想解（各指标最大值）
    V_neg = V.min(axis=0)   # 负理想解（各指标最小值）

    # —— Step 3: 距离 ——
    D_pos = np.sqrt(((V - V_pos) ** 2).sum(axis=1))
    D_neg = np.sqrt(((V - V_neg) ** 2).sum(axis=1))

    # —— Step 4: 相对贴近度 ——
    scores = safe_divide(D_neg, D_pos + D_neg, fill_value=0.0)

    # —— 排名（贴近度越大排名越高）——
    ranks = pd.Series(scores).rank(ascending=False).astype(int).values
    result_df = pd.DataFrame({
        "评价对象":  objects,
        "D+":        np.round(D_pos, 4),
        "D-":        np.round(D_neg, 4),
        "贴近度 C":  np.round(scores, 4),
        "排名":      ranks,
    }).sort_values("排名").reset_index(drop=True)

    print_ranking_table(objects, scores, "TOPSIS")
    return scores, result_df
{% endif %}


{% if use_vikor %}
def vikor(
    X_norm: np.ndarray,
    weights: np.ndarray,
    objects: np.ndarray,
    v: float = VIKOR_V,
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, pd.DataFrame]:
    """
    VIKOR（VlseKriterijumska Optimizacija i Kompromisno Resenje）。

    数学步骤
    --------
    1. 正理想解 f*_j = max_i(x_ij)，负理想解 f⁻_j = min_i(x_ij)
    2. 加权最大效用：S_i = Σ_j w_j(f*_j - x_ij)/(f*_j - f⁻_j)
       加权最大遗憾：R_i = max_j[w_j(f*_j - x_ij)/(f*_j - f⁻_j)]
    3. 综合指标：Q_i = v(S_i-S*)/(S⁻-S*) + (1-v)(R_i-R*)/(R⁻-R*)
       v=0.5 表示"多数准则"权重与"最小遗憾"权重平衡

    Parameters
    ----------
    v : 决策者偏好系数，v∈[0,1]，越大表示越强调多数准则

    Returns
    -------
    Q          : 综合指标向量（越小越优）
    result_df  : 含 S、R、Q 和排名的 DataFrame
    """
    _log = logger.info if logger else print
    m, n = X_norm.shape

    f_star = X_norm.max(axis=0)
    f_neg  = X_norm.min(axis=0)
    denom  = f_star - f_neg
    denom  = np.where(np.abs(denom) < 1e-12, 1e-12, denom)

    # 标准化差距矩阵
    gap = (f_star[np.newaxis, :] - X_norm) / denom[np.newaxis, :]
    weighted_gap = weights[np.newaxis, :] * gap

    S = weighted_gap.sum(axis=1)
    R = weighted_gap.max(axis=1)

    S_star, S_neg = S.min(), S.max()
    R_star, R_neg = R.min(), R.max()

    Q = (
        v * safe_divide(S - S_star, S_neg - S_star)
        + (1 - v) * safe_divide(R - R_star, R_neg - R_star)
    )

    ranks = pd.Series(Q).rank(ascending=True).astype(int).values
    result_df = pd.DataFrame({
        "评价对象": objects,
        "S 效用度": np.round(S, 4),
        "R 遗憾度": np.round(R, 4),
        "Q 综合":   np.round(Q, 4),
        "排名":     ranks,
    }).sort_values("排名").reset_index(drop=True)

    _log(f"\n  VIKOR (v={v}) 计算完成")
    print_ranking_table(objects, Q, "VIKOR Q值", ascending=True)
    return Q, result_df
{% endif %}


{% if use_gra %}
def grey_relational_analysis(
    X_norm: np.ndarray,
    weights: np.ndarray,
    objects: np.ndarray,
    rho: float = GRA_RHO,
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, pd.DataFrame]:
    """
    灰色关联分析（Grey Relational Analysis, GRA）。

    数学步骤
    --------
    1. 参考序列：x⁰_j = max_i(x_ij)（各指标最优值）
    2. 差序列：Δ_ij = |x⁰_j - x_ij|
    3. 灰色关联系数：
       ξ_ij = (Δ_min + ρ·Δ_max) / (Δ_ij + ρ·Δ_max)
       ρ 为分辨系数，默认 0.5
    4. 加权灰色关联度：r_i = Σ_j(w_j · ξ_ij)

    Parameters
    ----------
    rho : 分辨系数，越小差异越显著，默认 {{ evaluation.gra_rho }}

    Returns
    -------
    grd        : 加权灰色关联度数组（越大越优）
    result_df  : 含关联系数矩阵和加权度的 DataFrame
    """
    _log = logger.info if logger else print

    # —— 参考序列 ——
    x0 = X_norm.max(axis=0)  # shape (n,)

    # —— 差序列 ——
    delta = np.abs(X_norm - x0[np.newaxis, :])  # shape (m, n)

    delta_min = delta.min()
    delta_max = delta.max()

    # —— 关联系数矩阵 ——
    xi = (delta_min + rho * delta_max) / (delta + rho * delta_max + 1e-12)

    # —— 加权关联度 ——
    grd = xi @ weights  # shape (m,)

    ranks = pd.Series(grd).rank(ascending=False).astype(int).values
    result_df = pd.DataFrame({
        "评价对象":   objects,
        "灰色关联度": np.round(grd, 4),
        "排名":       ranks,
    }).sort_values("排名").reset_index(drop=True)

    _log(f"\n  灰色关联分析 (ρ={rho}) 计算完成")
    print_ranking_table(objects, grd, "GRA灰色关联度")
    return grd, result_df
{% endif %}


{% if use_fuzzy %}
def fuzzy_comprehensive_eval(
    data_matrix: np.ndarray,
    weights: np.ndarray,
    objects: np.ndarray,
    n_levels: int = 5,
    level_labels: Optional[List[str]] = None,
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, pd.DataFrame]:
    """
    模糊综合评价法（Fuzzy Comprehensive Evaluation）。

    实现说明
    --------
    采用梯形隶属度函数将各指标归一化值映射到 n_levels 个等级，
    通过模糊矩阵合成（最大最小合成算子或加权平均算子）得到综合评价向量，
    以重心法反模糊化计算综合得分。

    等级划分（5级示例）
    -------------------
    [0.0, 0.2) → 差（Level 1），[0.2, 0.4) → 较差 …… [0.8, 1.0] → 优（Level 5）

    Parameters
    ----------
    n_levels     : 评价等级数，默认 5
    level_labels : 等级名称，默认 ["差","较差","中","较好","优"]
    """
    _log = logger.info if logger else print
    m, n = data_matrix.shape

    if level_labels is None:
        level_labels = (
            ["差", "较差", "中", "较好", "优"]
            if n_levels == 5
            else [f"Level{i+1}" for i in range(n_levels)]
        )

    # —— 构建隶属度矩阵（梯形法，m 个对象 × n 个指标 × L 等级）——
    # 等级中心点
    centers = np.linspace(0, 1, n_levels)
    half_width = 1.0 / (n_levels - 1) / 2 if n_levels > 1 else 0.5

    def membership(x: float, c: float, hw: float) -> float:
        """三角隶属函数"""
        dist = abs(x - c)
        return max(0.0, 1.0 - dist / (hw + 1e-8))

    # 先对数据做列级 minmax 归一化
    X_mm = normalize_matrix(data_matrix, method="minmax")

    # 构建 R 矩阵（m × L）：对象 × 等级，通过加权平均各指标的隶属度
    R_obj = np.zeros((m, n_levels))
    for i in range(m):
        for lv in range(n_levels):
            r_vec = np.array([
                membership(X_mm[i, j], centers[lv], half_width)
                for j in range(n)
            ])
            R_obj[i, lv] = float(weights @ r_vec)

    # 行归一化（确保各行和为 1）
    row_sums = R_obj.sum(axis=1, keepdims=True)
    R_obj = safe_divide(R_obj, row_sums, fill_value=1.0 / n_levels)

    # —— 反模糊化：重心法（等级中心加权均值）——
    scores = R_obj @ centers  # shape (m,)

    ranks = pd.Series(scores).rank(ascending=False).astype(int).values
    result_df = pd.DataFrame(
        R_obj, columns=level_labels
    )
    result_df.insert(0, "评价对象", objects)
    result_df["综合得分"] = np.round(scores, 4)
    result_df["排名"] = ranks
    result_df = result_df.sort_values("排名").reset_index(drop=True)

    _log("\n  模糊综合评价完成")
    print_ranking_table(objects, scores, "模糊综合评价")
    return scores, result_df
{% endif %}


{% if use_rsr %}
def rank_sum_ratio(
    data_matrix: np.ndarray,
    weights: np.ndarray,
    objects: np.ndarray,
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, pd.DataFrame]:
    """
    秩和比法（Rank Sum Ratio, RSR）综合评价。

    数学步骤
    --------
    1. 各列升序编秩（tied rank 取平均秩）
    2. 加权秩和比：RSR_i = Σ_j(w_j · R_ij) / m，
       其中 m 为对象总数，R_ij 为第 i 个对象第 j 个指标的秩
    3. 按 RSR 值由大到小排名

    Returns
    -------
    rsr_scores : RSR 值数组
    result_df  : 含各指标秩、加权 RSR 和排名的 DataFrame
    """
    _log = logger.info if logger else print
    m, n = data_matrix.shape

    # —— 各列编秩 ——
    rank_matrix = np.zeros((m, n))
    for j in range(n):
        col = data_matrix[:, j]
        rank_matrix[:, j] = pd.Series(col).rank(ascending=True, method="average").values

    # —— 加权 RSR ——
    rsr_scores = (rank_matrix @ weights) / m

    ranks = pd.Series(rsr_scores).rank(ascending=False).astype(int).values
    result_df = pd.DataFrame(
        {"评价对象": objects, "RSR值": np.round(rsr_scores, 4), "排名": ranks}
    ).sort_values("排名").reset_index(drop=True)

    _log("\n  秩和比法计算完成")
    print_ranking_table(objects, rsr_scores, "RSR秩和比")
    return rsr_scores, result_df
{% endif %}


