def handle_missing_values(
    data_matrix: np.ndarray,
    indicator_names: List[str],
    strategy: str = MISSING_STRATEGY,
    threshold: float = 0.30,
    logger: Optional[logging.Logger] = None,
) -> np.ndarray:
    """
    缺失值处理。

    策略说明
    --------
    mean        : 用各列均值填充（连续型指标推荐）
    median      : 用各列中位数填充（含异常值时更稳健）
    drop        : 删除含缺失值的行
    interpolate : 线性插值（适用于有序样本）

    Parameters
    ----------
    threshold : 若某列缺失率超过此阈值则发出强警告

    Returns
    -------
    np.ndarray : 处理后的数据矩阵（无缺失值）
    """
    _log = logger.info if logger else print
    missing_count = np.isnan(data_matrix).sum()

    if missing_count == 0:
        _log("  ✅ 无缺失值，跳过缺失值处理步骤")
        return data_matrix.copy()

    _log(f"  发现缺失值: {missing_count} 个，策略: {strategy}")
    X = data_matrix.copy()
    n_cols = X.shape[1]

    # 高缺失率列警告
    for j in range(n_cols):
        col_missing_rate = np.isnan(X[:, j]).mean()
        if col_missing_rate > threshold:
            _log(
                f"  ⚠  指标 '{indicator_names[j]}' 缺失率 "
                f"{col_missing_rate:.1%} > {threshold:.0%}，建议检查数据来源"
            )

    if strategy == "mean":
        col_means = np.nanmean(X, axis=0)
        for j in range(n_cols):
            mask = np.isnan(X[:, j])
            X[mask, j] = col_means[j]

    elif strategy == "median":
        col_medians = np.nanmedian(X, axis=0)
        for j in range(n_cols):
            mask = np.isnan(X[:, j])
            X[mask, j] = col_medians[j]

    elif strategy == "drop":
        valid_rows = ~np.isnan(X).any(axis=1)
        X = X[valid_rows]
        _log(f"  删除含缺失值的行后，剩余样本数: {X.shape[0]}")

    elif strategy == "interpolate":
        df_temp = pd.DataFrame(X)
        df_temp = df_temp.interpolate(method="linear", limit_direction="both")
        X = df_temp.values

    else:
        raise ValueError(f"不支持的缺失值处理策略: '{strategy}'")

    _log(f"  缺失值处理完成，剩余缺失: {np.isnan(X).sum()} 个")
    return X


{% if preprocessing.handle_outliers %}
def handle_outliers(
    data_matrix: np.ndarray,
    indicator_names: List[str],
    method: str = "{{ preprocessing.outlier_method }}",
    threshold: float = 3.0,
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, Dict[str, List[int]]]:
    """
    异常值检测与处理（截断法：将异常值替换为边界值）。

    方法
    ----
    iqr    : 四分位距法，边界 = Q1 - 1.5·IQR 至 Q3 + 1.5·IQR
    zscore : Z-score 法，|z| > threshold 的点视为异常

    Returns
    -------
    X_clean      : 处理后矩阵
    outlier_info : dict {指标名: [异常值所在行索引]}
    """
    _log = logger.info if logger else print
    X = data_matrix.copy()
    n_rows, n_cols = X.shape
    outlier_info: Dict[str, List[int]] = {}

    for j in range(n_cols):
        col = X[:, j]
        if method == "iqr":
            q1, q3 = np.nanpercentile(col, 25), np.nanpercentile(col, 75)
            iqr = q3 - q1
            lower, upper = q1 - 1.5 * iqr, q3 + 1.5 * iqr
        else:  # zscore
            mu, sigma = np.nanmean(col), np.nanstd(col)
            lower = mu - threshold * sigma
            upper = mu + threshold * sigma

        outlier_idx = np.where((col < lower) | (col > upper))[0].tolist()
        if outlier_idx:
            outlier_info[indicator_names[j]] = outlier_idx
            X[:, j] = np.clip(col, lower, upper)  # 截断至边界值
            _log(
                f"  [异常值] 指标 '{indicator_names[j]}' "
                f"发现 {len(outlier_idx)} 个异常，已截断至 [{lower:.3f}, {upper:.3f}]"
            )

    if not outlier_info:
        _log("  ✅ 未发现显著异常值")
    return X, outlier_info
{% endif %}


def directionalize(
    data_matrix: np.ndarray,
    directions: List[int],
    moderate_opts: Optional[List[Optional[float]]] = None,
) -> np.ndarray:
    """
    指标正向化处理（统一为"越大越好"方向）。

    正向化规则
    ----------
    正向型 (+1) : 保持原值（不变）
    负向型 (-1) : 取倒数或 max - x 变换（使用 max - x + min）
    适度型 ( 0) : M - |x - x*|，x* 为最优值（默认取均值）

    Parameters
    ----------
    moderate_opts : 适度型指标的最优值列表；None 则对应列取均值

    Returns
    -------
    np.ndarray : 正向化后的数据矩阵（所有指标均"越大越好"）
    """
    X = data_matrix.copy().astype(float)
    n_rows, n_cols = X.shape

    for j in range(n_cols):
        col = X[:, j]
        d = directions[j]

        if d == 1:
            pass  # 正向型，无需处理

        elif d == -1:
            # 负向型：max(col) - col + min(col) 保持非负且值域对称
            X[:, j] = col.max() - col + col.min()

        elif d == 0:
            # 适度型：M - |x - x*|
            opt = (
                moderate_opts[j]
                if moderate_opts and moderate_opts[j] is not None
                else float(np.nanmean(col))
            )
            diff = np.abs(col - opt)
            M = diff.max()
            X[:, j] = M - diff  # 越接近 x* 越大

    return X


def normalize_matrix(
    data_matrix: np.ndarray,
    method: str = NORMALIZE_METHOD,
) -> np.ndarray:
    """
    归一化处理（在正向化后的矩阵上执行）。

    方法
    ----
    minmax  : x' = (x - min) / (max - min)，值域 [0, 1]
    zscore  : x' = (x - μ) / σ，标准正态分布变换
    vector  : x' = x / ||x||，向量长度归一化（TOPSIS 标准形式）
    sum     : x' = x / sum(x)，概率归一化

    Returns
    -------
    np.ndarray : 归一化矩阵，与输入 shape 相同
    """
    X = data_matrix.copy().astype(float)
    n_rows, n_cols = X.shape

    for j in range(n_cols):
        col = X[:, j]
        if method == "minmax":
            c_min, c_max = col.min(), col.max()
            X[:, j] = safe_divide(col - c_min, c_max - c_min, fill_value=0.0)

        elif method == "zscore":
            mu, sigma = col.mean(), col.std()
            X[:, j] = safe_divide(col - mu, sigma, fill_value=0.0)

        elif method == "vector":
            norm = np.sqrt((col ** 2).sum())
            X[:, j] = safe_divide(col, norm, fill_value=0.0)

        elif method == "sum":
            s = col.sum()
            X[:, j] = safe_divide(col, s, fill_value=1.0 / n_rows)

        else:
            raise ValueError(f"不支持的归一化方法: '{method}'")

    return X


