{% if use_entropy %}
def entropy_weight(
    X_norm: np.ndarray,
    indicator_names: List[str],
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, pd.DataFrame]:
    """
    熵权法（Entropy Weight Method）计算客观权重。

    数学原理
    --------
    1. 构造概率矩阵：p_ij = x_ij / Σ_i(x_ij)
    2. 计算信息熵：e_j = -1/ln(m) * Σ_i(p_ij · ln(p_ij))
    3. 差异系数：d_j = 1 - e_j
    4. 归一化权重：w_j = d_j / Σ_j(d_j)

    Parameters
    ----------
    X_norm : 已正向化且归一化的数据矩阵，shape=(m, n)
             要求所有元素 > 0（若含 0 会自动平移处理）

    Returns
    -------
    weights    : 权重向量，shape=(n,)
    detail_df  : 详细计算过程 DataFrame
                 列：指标名 | 信息熵 | 差异系数 | 权重
    """
    _log = logger.info if logger else print
    m, n = X_norm.shape
    X = X_norm.copy().astype(float)

    # 确保非负：若有 ≤ 0 的元素，整体平移至严格正数区间
    col_min = X.min(axis=0)
    shift = np.where(col_min <= 0, -col_min + 1e-6, 0)
    X += shift

    # —— Step 1: 概率矩阵 ——
    col_sums = X.sum(axis=0)
    P = safe_divide(X, col_sums[np.newaxis, :], fill_value=1.0 / m)

    # —— Step 2: 信息熵 ——
    ln_P = np.where(P > 0, np.log(P), 0.0)
    entropy = -np.sum(P * ln_P, axis=0) / np.log(m)

    # —— Step 3 & 4: 差异系数与权重 ——
    diversity = 1.0 - entropy
    weights = normalize_weights(diversity)

    detail_df = pd.DataFrame({
        "指标":     indicator_names,
        "信息熵 e": np.round(entropy, 6),
        "差异系数": np.round(diversity, 6),
        "权重 w":   np.round(weights, 6),
    })

    _log("\n  熵权法计算完成:")
    print(detail_df.to_string(index=False))
    return weights, detail_df
{% endif %}


{% if use_critic %}
def critic_weight(
    X_norm: np.ndarray,
    indicator_names: List[str],
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, pd.DataFrame]:
    """
    CRITIC 法（Criteria Importance Through Intercriteria Correlation）。

    数学原理
    --------
    1. 对比强度（标准差）：σ_j = std(x_j)
    2. 冲突性（相关性）  ：r_jk = corr(x_j, x_k)
       信息量 C_j = σ_j · Σ_k(1 - r_jk)
    3. 权重：w_j = C_j / Σ_j(C_j)

    Returns
    -------
    weights    : 权重向量
    detail_df  : 含标准差、信息量、权重的详细 DataFrame
    """
    _log = logger.info if logger else print
    m, n = X_norm.shape

    # —— 标准差（对比强度）——
    sigma = X_norm.std(axis=0, ddof=1)

    # —— 相关系数矩阵（冲突性）——
    R = np.corrcoef(X_norm.T)

    # —— 信息量 ——
    conflict = np.sum(1.0 - np.abs(R), axis=0)  # 各列与其余列绝对相关差之和
    C = sigma * conflict

    # —— 权重 ——
    weights = normalize_weights(C)

    detail_df = pd.DataFrame({
        "指标":      indicator_names,
        "标准差 σ":  np.round(sigma, 4),
        "信息量 C":  np.round(C, 4),
        "权重 w":    np.round(weights, 6),
    })

    _log("\n  CRITIC 法计算完成:")
    print(detail_df.to_string(index=False))
    return weights, detail_df
{% endif %}


