{% if preprocessing.use_pca %}
def plot_pca_scree(
    pca_model: "PCA",
    save_path: Optional[str] = None,
    show: bool = SHOW_PLOTS,
) -> plt.Figure:
    """绘制 PCA 碎石图（各主成分解释方差率 + 累积曲线）。"""
    explained = pca_model.explained_variance_ratio_
    cum_explained = np.cumsum(explained)
    n_comp = len(explained)

    fig, ax1 = plt.subplots(figsize=(max(6, n_comp * 0.8), 5))
    ax2 = ax1.twinx()

    ax1.bar(range(1, n_comp + 1), explained * 100, color="steelblue",
            alpha=0.7, label="各主成分方差贡献率")
    ax2.plot(range(1, n_comp + 1), cum_explained * 100, "ro-",
             linewidth=2, label="累积方差贡献率")
    ax2.axhline(y=85, color="gray", linestyle="--", alpha=0.6, label="85% 阈值线")

    ax1.set_xlabel("主成分编号", fontsize=12)
    ax1.set_ylabel("方差贡献率 (%)", color="steelblue", fontsize=11)
    ax2.set_ylabel("累积贡献率 (%)", color="red", fontsize=11)
    ax1.set_title("PCA 碎石图 — 主成分方差解释", fontsize=13, fontweight="bold")

    lines1, labels1 = ax1.get_legend_handles_labels()
    lines2, labels2 = ax2.get_legend_handles_labels()
    ax1.legend(lines1 + lines2, labels1 + labels2, loc="center right", fontsize=9)
    plt.tight_layout()
    if save_path:
        save_figure(fig, Path(save_path).stem, str(Path(save_path).parent))
    if show:
        plt.show()
    return fig
{% endif %}


{# ──────────────────────────────────────────────────────────────── #}
{# 第十部分：主工作流函数                                            #}
{# ──────────────────────────────────────────────────────────────── #}
# ================================================================
# 主工作流（Main Workflow）
# ================================================================

def run_evaluation_pipeline(logger: logging.Logger) -> Dict[str, Any]:
    """
    执行完整的评价工作流，返回所有中间结果与最终产物字典。

    工作流步骤
    ----------
    {% for step in workflow_steps %}
    Step {{ loop.index }}: {{ step }}
    {% endfor %}

    Returns
    -------
    results : dict，包含权重、得分、排名、图片路径等所有产物
    """
    results: Dict[str, Any] = {
        "meta":        {
            "project":    "{{ meta.project_name }}",
            "timestamp":  datetime.now().isoformat(),
            "config":     "{{ meta.config_source }}",
        },
        "paths":       {},
        "weights":     {},
        "scores":      {},
        "rankings":    {},
        "figures":     {},
        "sensitivity": {},
    }

    # —— 初始化输出目录 ——
    dirs = setup_output_dirs(OUTPUT_DIR)
    logger.info("输出目录已准备: %s", OUTPUT_DIR)

    # ================================================================
    # STEP 1: 数据加载
    # ================================================================
    print_step(1, "数据加载", total={{ workflow_steps | length }})
    objects, data_raw, df_raw = load_data(
        filepath=DATA_FILE,
        eval_col=EVAL_OBJECTS_COL,
        indicator_cols=INDICATOR_COLS,
        encoding="{{ config.encoding }}",
        logger=logger,
    )
    report = validate_data(data_raw, objects, INDICATOR_NAMES, logger)
    if not report["passed"]:
        logger.warning("数据质量未完全通过，请关注上述警告信息")

    # ================================================================
    # STEP 2: 数据预处理
    # ================================================================
    print_step(2, "数据预处理（缺失处理 → 正向化 → 归一化）", total={{ workflow_steps | length }})

    {% if preprocessing.handle_missing %}
    data_clean = handle_missing_values(
        data_raw, INDICATOR_NAMES,
        strategy=MISSING_STRATEGY, logger=logger,
    )
    {% else %}
    data_clean = data_raw.copy()
    logger.info("  跳过缺失值处理（配置已禁用）")
    {% endif %}

    {% if preprocessing.handle_outliers %}
    data_clean, outlier_info = handle_outliers(
        data_clean, INDICATOR_NAMES, logger=logger,
    )
    results["outlier_info"] = outlier_info
    {% endif %}

    # 相关性检验
    {% if preprocessing.check_correlation %}
    corr_df, high_corr_pairs = correlation_matrix(data_clean, INDICATOR_NAMES)
    if high_corr_pairs:
        logger.warning(
            "发现高相关指标对（|r|>0.85）: %s，"
            "建议考虑降维或合并指标",
            [(a, b, f"{r:.3f}") for a, b, r in high_corr_pairs],
        )
    if SAVE_CSV:
        save_dataframe(corr_df, "indicator_correlation", dirs["tables"], logger=logger)
    {% endif %}

    {% if preprocessing.use_pca %}
    # —— PCA 降维 ——
    print("  → 执行 PCA 降维...")
    data_for_weights, pca_model, pc_names, loadings_df = apply_pca(
        data_clean, INDICATOR_NAMES, variance_ratio={{ preprocessing.pca_variance }}, logger=logger,
    )
    if SAVE_CSV:
        save_dataframe(loadings_df, "pca_loadings", dirs["tables"], logger=logger)
    indicator_names_used = pc_names
    if SAVE_FIGURES:
        fig_pca = plot_pca_scree(pca_model, save_path=os.path.join(dirs["figures"], "pca_scree"))
        results["figures"]["pca_scree"] = os.path.join(dirs["figures"], f"pca_scree.{FIG_FORMAT}")
    {% else %}
    # 无 PCA：正向化 + 归一化
    data_positive = directionalize(data_clean, INDICATOR_DIRS, MODERATE_OPTS)
    data_for_weights = normalize_matrix(data_positive, method=NORMALIZE_METHOD)
    indicator_names_used = INDICATOR_NAMES
    {% endif %}

    # ================================================================
    # STEP 3: 指标权重计算
    # ================================================================
    print_step(3, f"权重计算（{WEIGHT_METHOD}）", total={{ workflow_steps | length }})

    {% if use_entropy %}
    weights_entropy, entropy_detail_df = entropy_weight(
        data_for_weights, indicator_names_used, logger=logger,
    )
    results["weights"]["entropy"] = weights_entropy.tolist()
    if SAVE_CSV:
        save_dataframe(entropy_detail_df, "weights_entropy", dirs["tables"], logger=logger)
    {% endif %}

    {% if use_critic %}
    weights_critic, critic_detail_df = critic_weight(
        data_for_weights, indicator_names_used, logger=logger,
    )
    results["weights"]["critic"] = weights_critic.tolist()
    if SAVE_CSV:
        save_dataframe(critic_detail_df, "weights_critic", dirs["tables"], logger=logger)
    {% endif %}

    {% if use_stddev %}
    weights_stddev, stddev_detail_df = stddev_weight(
        data_for_weights, indicator_names_used, logger=logger,
    )
    results["weights"]["stddev"] = weights_stddev.tolist()
    if SAVE_CSV:
        save_dataframe(stddev_detail_df, "weights_stddev", dirs["tables"], logger=logger)
    {% endif %}

    {% if use_ahp %}
    weights_ahp, ci_ahp, cr_ahp, ahp_passed = ahp_weight(
        AHP_MATRIX, indicator_names_used, logger=logger,
    )
    results["weights"]["ahp"] = weights_ahp.tolist()
    results["weights"]["ahp_cr"] = cr_ahp
    {% endif %}

    {% if use_combination_weights %}
    # —— 组合赋权 ——
    weights_list_for_combine = [
        {% if use_entropy %}weights_entropy,{% endif %}
        {% if use_critic %}weights_critic,{% endif %}
        {% if use_ahp %}weights_ahp,{% endif %}
    ]
    method_names_combine = [
        {% if use_entropy %}"熵权法",{% endif %}
        {% if use_critic %}"CRITIC法",{% endif %}
        {% if use_ahp %}"AHP法",{% endif %}
    ]
    coef_combine = {% if weights.combination_coef is not none %}{{ weights.combination_coef | tojson }}{% else %}None{% endif %}

    final_weights, compare_df = combine_weights(
        weights_list_for_combine,
        method_names_combine,
        coef=coef_combine,
        method="{{ weights.combination_method | default('linear') }}",
        logger=logger,
    )
    results["weights"]["combination"] = final_weights.tolist()
    if SAVE_CSV:
        save_dataframe(compare_df, "weights_comparison", dirs["tables"], logger=logger)
    {% elif use_entropy %}
    final_weights = weights_entropy
    {% elif use_critic %}
    final_weights = weights_critic
    {% elif use_ahp %}
    final_weights = weights_ahp
    {% elif use_stddev %}
    final_weights = weights_stddev
    {% else %}
    # 等权重（fallback）
    n_ind = len(indicator_names_used)
    final_weights = np.full(n_ind, 1.0 / n_ind)
    logger.warning("未选定赋权方法，使用等权重")
    {% endif %}

    # 权重可视化
    if SAVE_FIGURES:
        fig_w = plot_weights_bar(
            final_weights, indicator_names_used,
            method_name=WEIGHT_METHOD,
            save_path=os.path.join(dirs["figures"], "weights_bar"),
        )
        results["figures"]["weights_bar"] = os.path.join(dirs["figures"], f"weights_bar.{FIG_FORMAT}")

    # 相关性热力图（原始指标）
    if SAVE_FIGURES:
        fig_corr = plot_correlation_heatmap(
            data_clean, INDICATOR_NAMES,
            save_path=os.path.join(dirs["figures"], "correlation_heatmap"),
        )
        results["figures"]["correlation_heatmap"] = os.path.join(
            dirs["figures"], f"correlation_heatmap.{FIG_FORMAT}"
        )

    # ================================================================
    # STEP 4: 综合评价
    # ================================================================
    print_step(4, f"综合评价（{EVAL_MODEL}）", total={{ workflow_steps | length }})
    all_scores: Dict[str, np.ndarray] = {}

    {% if use_topsis %}
    topsis_scores, topsis_result_df = topsis(
        data_for_weights, final_weights, objects, logger=logger,
    )
    results["scores"]["topsis"] = topsis_scores.tolist()
    all_scores["TOPSIS"] = topsis_scores
    if SAVE_CSV:
        save_dataframe(topsis_result_df, "result_topsis", dirs["tables"], logger=logger)
    {% endif %}

    {% if use_vikor %}
    vikor_Q, vikor_result_df = vikor(
        data_for_weights, final_weights, objects,
        v=VIKOR_V, logger=logger,
    )
    results["scores"]["vikor_Q"] = vikor_Q.tolist()
    all_scores["VIKOR"] = -vikor_Q   # 取负使得越大越好，方便对比
    if SAVE_CSV:
        save_dataframe(vikor_result_df, "result_vikor", dirs["tables"], logger=logger)
    {% endif %}

    {% if use_gra %}
    gra_scores, gra_result_df = grey_relational_analysis(
        data_for_weights, final_weights, objects,
        rho=GRA_RHO, logger=logger,
    )
    results["scores"]["gra"] = gra_scores.tolist()
    all_scores["GRA"] = gra_scores
    if SAVE_CSV:
        save_dataframe(gra_result_df, "result_gra", dirs["tables"], logger=logger)
    {% endif %}

    {% if use_fuzzy %}
    fuzzy_scores, fuzzy_result_df = fuzzy_comprehensive_eval(
        data_positive, final_weights, objects, logger=logger,
    )
    results["scores"]["fuzzy"] = fuzzy_scores.tolist()
    all_scores["模糊综评"] = fuzzy_scores
    if SAVE_CSV:
        save_dataframe(fuzzy_result_df, "result_fuzzy", dirs["tables"], logger=logger)
    {% endif %}

    {% if use_rsr %}
    rsr_scores, rsr_result_df = rank_sum_ratio(
        data_clean, final_weights, objects, logger=logger,
    )
    results["scores"]["rsr"] = rsr_scores.tolist()
    all_scores["RSR"] = rsr_scores
    if SAVE_CSV:
        save_dataframe(rsr_result_df, "result_rsr", dirs["tables"], logger=logger)
    {% endif %}

    # 选定主要模型得分用于后续分析
    primary_scores = results["scores"].get(
        EVAL_MODEL,
        next(iter(results["scores"].values())) if results["scores"] else np.zeros(len(objects))
    )
    primary_scores = np.array(primary_scores)

    # ================================================================
    # STEP 5: 可视化
    # ================================================================
    print_step(5, "结果可视化", total={{ workflow_steps | length }})

    if SAVE_FIGURES:
        # 排名条形图
        fig_rank = plot_ranking_bar(
            primary_scores, objects,
            method_name=EVAL_MODEL.upper(),
            save_path=os.path.join(dirs["figures"], "ranking_bar"),
        )
        results["figures"]["ranking_bar"] = os.path.join(dirs["figures"], f"ranking_bar.{FIG_FORMAT}")

        # 雷达图
        fig_radar = plot_radar(
            data_for_weights[np.argsort(primary_scores)[::-1]],
            indicator_names_used,
            objects[np.argsort(primary_scores)[::-1]],
            top_n=min(5, len(objects)),
            save_path=os.path.join(dirs["figures"], "radar_chart"),
        )
        results["figures"]["radar"] = os.path.join(dirs["figures"], f"radar_chart.{FIG_FORMAT}")

    {% if use_multiple_models %}
    # 多方法对比图
    if SAVE_FIGURES and len(all_scores) > 1:
        fig_compare = plot_method_comparison(
            all_scores, objects,
            save_path=os.path.join(dirs["figures"], "method_comparison"),
        )
        results["figures"]["method_comparison"] = os.path.join(
            dirs["figures"], f"method_comparison.{FIG_FORMAT}"
        )
    {% endif %}

    {% if use_sensitivity %}
    # ================================================================
    # STEP 6: 灵敏度分析
    # ================================================================
    print_step(6, f"权重灵敏度分析（OAT ±{SENSITIVITY_RANGE*100:.0f}%）", total={{ workflow_steps | length }})

    # 选择主评价函数进行灵敏度分析
    {% if use_topsis %}
    _sens_func = topsis
    _sens_name = "TOPSIS"
    {% elif use_gra %}
    _sens_func = grey_relational_analysis
    _sens_name = "GRA"
    {% elif use_vikor %}
    _sens_func = vikor
    _sens_name = "VIKOR"
    {% else %}
    _sens_func = None
    _sens_name = "N/A"
    {% endif %}

    if _sens_func is not None:
        sens_score_df, sens_rank_df = sensitivity_analysis_oat(
            data_for_weights, final_weights,
            indicator_names_used, objects,
            eval_func=_sens_func,
            perturb_range=SENSITIVITY_RANGE,
            n_steps=SENSITIVITY_STEPS,
            logger=logger,
        )
        results["sensitivity"]["score_df"] = sens_score_df.to_dict(orient="records")

        if SAVE_CSV:
            save_dataframe(sens_score_df, "sensitivity_scores", dirs["tables"], logger=logger)
            save_dataframe(sens_rank_df,  "sensitivity_ranks",  dirs["tables"], logger=logger)

        if SAVE_FIGURES:
            fig_sens = plot_sensitivity_curves(
                sens_score_df, objects,
                indicator_names_used,
                method_name=_sens_name,
                save_path=os.path.join(dirs["figures"], "sensitivity_curves"),
            )
            results["figures"]["sensitivity"] = os.path.join(
                dirs["figures"], f"sensitivity_curves.{FIG_FORMAT}"
            )
    {% endif %}

    # ================================================================
    # STEP {{ workflow_steps | length }}: 结果汇总与导出
    # ================================================================
    print_step({{ workflow_steps | length }}, "结果汇总与导出", total={{ workflow_steps | length }})

    # 汇总最终排名
    primary_scores_arr = np.array(primary_scores)
    sort_idx = np.argsort(primary_scores_arr)[::-1]
    final_ranking_df = pd.DataFrame({
        "排名":   range(1, len(objects) + 1),
        "评价对象": [objects[i] for i in sort_idx],
        "综合得分": [round(float(primary_scores_arr[i]), 4) for i in sort_idx],
        "赋权方法": WEIGHT_METHOD,
        "评价模型": EVAL_MODEL,
    })

    if SAVE_CSV:
        save_dataframe(final_ranking_df, "final_ranking", dirs["tables"], logger=logger)

    # 保存完整结果字典（JSON 格式）
    results_json_path = os.path.join(dirs["base"], "results_summary.json")
    serializable = {
        k: v for k, v in results.items()
        if k not in ("sensitivity",)   # 跳过大型 DataFrame
    }
    with open(results_json_path, "w", encoding="utf-8") as f:
        json.dump(serializable, f, ensure_ascii=False, indent=2)
    logger.info("结果摘要已保存: %s", results_json_path)

    # 打印最终摘要
    print_section("🏆  最终评价结果摘要")
    print(f"  项目名称  : {{ meta.project_name }}")
    print(f"  赋权方法  : {WEIGHT_METHOD}")
    print(f"  评价模型  : {EVAL_MODEL}")
    print(f"  评价对象数: {len(objects)}")
    print(f"  评价指标数: {len(INDICATOR_COLS)}")
    print()
    print(final_ranking_df.to_string(index=False))
    print_section("输出文件清单")
    print(f"  📁 输出根目录 : {os.path.abspath(OUTPUT_DIR)}")
    print(f"  📊 结果表格   : {dirs['tables']}/")
    print(f"  🖼  可视化图片: {dirs['figures']}/")
    print(f"  📝 结果摘要   : {results_json_path}")

    return results


