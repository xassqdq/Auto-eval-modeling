{% if use_sensitivity %}
# ================================================================
# 灵敏度分析模块
# ================================================================

def sensitivity_analysis_oat(
    X_norm: np.ndarray,
    base_weights: np.ndarray,
    indicator_names: List[str],
    objects: np.ndarray,
    eval_func,
    perturb_range: float = SENSITIVITY_RANGE,
    n_steps: int = SENSITIVITY_STEPS,
    logger: Optional[logging.Logger] = None,
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """
    OAT（One-At-a-Time）权重灵敏度分析。

    原理
    ----
    每次固定 n-1 个权重不变，单独扰动第 j 个权重在
    [(1-δ)·w_j, (1+δ)·w_j] 范围内均匀取值（共 n_steps 步），
    观察各评价对象得分与排名的变化程度。

    Parameters
    ----------
    eval_func    : 评价函数 f(X_norm, weights, objects) → (scores, _)
                   如 topsis / grey_relational_analysis 等
    perturb_range: 扰动比例 δ，默认 ±{{ sensitivity.perturbation_range * 100:.0f }}%
    n_steps      : 每个指标的扰动步数，默认 {{ sensitivity.steps }}

    Returns
    -------
    score_df     : 各指标扰动下的得分变化 DataFrame
                   shape = (n_indicators × n_steps, n_objects + 2)
    rank_df      : 对应的排名变化 DataFrame（同 shape）
    """
    _log = logger.info if logger else print
    n = len(base_weights)
    m = X_norm.shape[0]
    perturbations = np.linspace(1 - perturb_range, 1 + perturb_range, n_steps)

    score_records: List[Dict] = []
    rank_records:  List[Dict] = []

    for j in range(n):
        for factor in perturbations:
            # 扰动第 j 个权重
            w_new = base_weights.copy()
            w_new[j] = base_weights[j] * factor

            # 其余权重等比例缩放以保证 sum = 1
            w_rest_sum = w_new.copy()
            w_rest_sum[j] = 0.0
            rest_scale = (1.0 - w_new[j]) / (w_rest_sum.sum() + 1e-12)
            w_new = np.where(
                np.arange(n) == j,
                w_new[j],
                w_new * rest_scale,
            )
            w_new = normalize_weights(w_new)

            # 执行评价
            try:
                scores, _ = eval_func(X_norm, w_new, objects)
            except Exception:
                scores = np.full(m, np.nan)

            s_row = {"指标": indicator_names[j], "扰动因子": round(factor, 4)}
            r_row = {"指标": indicator_names[j], "扰动因子": round(factor, 4)}
            for i, obj in enumerate(objects):
                s_row[str(obj)] = round(float(scores[i]), 4)
                r_row[str(obj)] = int(
                    pd.Series(scores).rank(ascending=False).iloc[i]
                )
            score_records.append(s_row)
            rank_records.append(r_row)

    score_df = pd.DataFrame(score_records)
    rank_df  = pd.DataFrame(rank_records)
    _log(f"\n  灵敏度分析完成：共测试 {n} 个指标 × {n_steps} 步 = {n * n_steps} 次评价")
    return score_df, rank_df
{% endif %}


