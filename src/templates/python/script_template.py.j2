def apply_pca(
    data_matrix: np.ndarray,
    indicator_names: List[str],
    n_components: Optional[int] = None,
    variance_ratio: float = {{ preprocessing.pca_variance }},
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, PCA, List[str], pd.DataFrame]:
    """
    对指标矩阵执行 PCA 降维。

    Parameters
    ----------
    n_components   : 指定主成分数；None 则按 variance_ratio 自动确定
    variance_ratio : 累计方差贡献率阈值（默认 {{ preprocessing.pca_variance }}）

    Returns
    -------
    X_pca          : 降维后矩阵
    pca_model      : 拟合好的 PCA 模型（可用于 transform 新数据）
    pc_names       : 主成分名称列表，如 ["PC1", "PC2", ...]
    loadings_df    : 载荷矩阵 DataFrame（原始指标 × 主成分）
    """
    _log = logger.info if logger else print
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(data_matrix)

    # 先拟合全部主成分以绘制碎石图
    pca_full = PCA()
    pca_full.fit(X_scaled)
    cum_var = np.cumsum(pca_full.explained_variance_ratio_)

    if n_components is None:
        n_components = int(np.searchsorted(cum_var, variance_ratio)) + 1
        _log(
            f"  PCA：保留累计方差 >= {variance_ratio:.0%} 所需主成分数 = {n_components}"
        )

    pca_model = PCA(n_components=n_components)
    X_pca = pca_model.fit_transform(X_scaled)
    pc_names = [f"PC{i+1}" for i in range(n_components)]

    var_ratios = pca_model.explained_variance_ratio_
    _log(f"  各主成分方差贡献率: {[f'{r:.3f}' for r in var_ratios]}")
    _log(f"  累计方差贡献率: {var_ratios.sum():.3f}")

    # 载荷矩阵
    loadings_df = pd.DataFrame(
        pca_model.components_.T,
        index=indicator_names,
        columns=pc_names,
    )

    return X_pca, pca_model, pc_names, loadings_df
{% endif %}


