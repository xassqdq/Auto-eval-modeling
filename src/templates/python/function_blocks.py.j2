def load_data(
    filepath: str,
    eval_col: str,
    indicator_cols: List[str],
    encoding: str = "{{ config.encoding }}",
    sheet_name: Optional[Union[str, int]] = {% if config.sheet_name is not none %}{{ config.sheet_name | tojson }}{% else %}None{% endif %},
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, np.ndarray, pd.DataFrame]:
    """
    加载评价数据文件，支持 CSV 与 Excel 格式。

    Parameters
    ----------
    filepath       : 数据文件路径（.csv / .xlsx / .xls）
    eval_col       : 评价对象所在列名（如 "城市"、"方案"）
    indicator_cols : 指标列名列表
    encoding       : CSV 文件编码
    sheet_name     : Excel 工作表名 / 索引；None → 第一张表
    logger         : 日志记录器（可选）

    Returns
    -------
    objects        : 评价对象名称数组，shape = (n_objects,)
    data_matrix    : 指标数据矩阵（浮点型），shape = (n_objects, n_indicators)
    raw_df         : 原始 DataFrame（含所有列，保留供后续使用）

    Raises
    ------
    FileNotFoundError : 文件不存在
    KeyError          : 指定列名不在数据文件中
    ValueError        : 无法解析的文件格式
    """
    _log = logger.info if logger else print

    # —— 文件存在性检验 ——
    if not os.path.exists(filepath):
        raise FileNotFoundError(f"数据文件不存在: {filepath}")

    suffix = Path(filepath).suffix.lower()
    _log(f"正在读取数据文件: {filepath}  (格式: {suffix})")

    # —— 按格式读取 ——
    if suffix in (".xlsx", ".xls", ".xlsm", ".xlsb"):
        raw_df = pd.read_excel(
            filepath,
            sheet_name=(sheet_name if sheet_name is not None else 0),
        )
    elif suffix == ".csv":
        raw_df = pd.read_csv(filepath, encoding=encoding)
    else:
        raise ValueError(
            f"不支持的文件格式: '{suffix}'。"
            "请提供 .csv / .xlsx / .xls 文件。"
        )

    # —— 列名校验 ——
    all_required = [eval_col] + indicator_cols
    missing = [c for c in all_required if c not in raw_df.columns]
    if missing:
        raise KeyError(
            f"数据文件缺少以下列: {missing}\n"
            f"文件实际包含列: {raw_df.columns.tolist()}"
        )

    # —— 提取对象名与指标矩阵 ——
    objects = raw_df[eval_col].astype(str).values
    data_matrix = (
        raw_df[indicator_cols]
        .apply(pd.to_numeric, errors="coerce")
        .values
        .astype(float)
    )

    _log(f"数据加载完成 → 评价对象: {len(objects)} 个，指标: {len(indicator_cols)} 个")
    return objects, data_matrix, raw_df


# ------------------------------------------------------------------
# ❹  数据质量验证
# ------------------------------------------------------------------

def validate_data(
    data_matrix: np.ndarray,
    objects: np.ndarray,
    indicator_names: List[str],
    logger: Optional[logging.Logger] = None,
) -> Dict[str, Any]:
    """
    对原始数据矩阵进行质量检查，返回质量报告字典。

    检查项目
    --------
    · 缺失值数量与比例（逐列统计）
    · 零方差列（无区分度指标）
    · 极端异常值（IQR 方法初步标记）
    · 样本量 vs 指标数比例建议

    Returns
    -------
    report : dict
        n_objects       样本量
        n_indicators    指标数
        missing_total   缺失值总数
        missing_by_col  各列缺失率 dict {col_name: rate}
        zero_var_cols   方差为零的列名列表
        warnings        警告信息列表
        passed          是否通过基本质量门槛（bool）
    """
    _log = logger.warning if logger else print
    n_obj, n_ind = data_matrix.shape

    # —— 缺失值统计 ——
    missing_mask = np.isnan(data_matrix)
    missing_total = int(missing_mask.sum())
    missing_by_col = {
        indicator_names[j]: float(missing_mask[:, j].mean())
        for j in range(n_ind)
    }

    # —— 零方差检验 ——
    variances = np.nanvar(data_matrix, axis=0)
    zero_var_cols = [indicator_names[j] for j in range(n_ind) if variances[j] < 1e-12]

    warnings_list: List[str] = []
    if missing_total > 0:
        warnings_list.append(
            f"共发现 {missing_total} 个缺失值 "
            f"（总缺失率 {missing_total / data_matrix.size:.1%}）"
        )
    if zero_var_cols:
        warnings_list.append(
            f"以下指标方差为零，无区分能力，建议剔除: {zero_var_cols}"
        )
    if n_obj < n_ind:
        warnings_list.append(
            f"样本量({n_obj}) < 指标数({n_ind})，"
            "建议考虑 PCA 降维以减少多重共线性影响"
        )
    if n_obj < 5:
        warnings_list.append(
            f"样本量过小({n_obj})，评价结果稳健性存疑，"
            "建议谨慎解读"
        )

    passed = (missing_total == 0 or missing_total / data_matrix.size < 0.30) and \
             not zero_var_cols

    report = {
        "n_objects":      n_obj,
        "n_indicators":   n_ind,
        "missing_total":  missing_total,
        "missing_by_col": missing_by_col,
        "zero_var_cols":  zero_var_cols,
        "warnings":       warnings_list,
        "passed":         passed,
    }

    # —— 控制台输出 ——
    print_section("数据质量报告")
    print(f"  评价对象数  : {n_obj}")
    print(f"  评价指标数  : {n_ind}")
    print(f"  缺失值总计  : {missing_total} ({missing_total/data_matrix.size:.1%})")
    print(f"  质量门槛    : {'✅ 通过' if passed else '⚠️  未完全通过（请检查警告）'}")
    if warnings_list:
        print("  警告信息    :")
        for w in warnings_list:
            print(f"    ⚠  {w}")
    return report


