def setup_output_dirs(base_dir: str = r"{{ config.output_dir }}") -> Dict[str, str]:
    """
    创建标准输出目录树，返回各子目录的绝对路径字典。

    目录结构
    --------
    <base_dir>/
        ├── reports/     LaTeX 源码与编译产物
        ├── figures/     可视化图片
        ├── tables/      中间结果 CSV 表格
        ├── scripts/     生成的独立可执行脚本
        └── logs/        运行日志

    Returns
    -------
    dict : {"base", "reports", "figures", "tables", "scripts", "logs"}
           各键对应创建完成的绝对路径字符串
    """
    sub_dirs = ["reports", "figures", "tables", "scripts", "logs"]
    dirs: Dict[str, str] = {"base": os.path.abspath(base_dir)}
    for name in sub_dirs:
        path = os.path.join(base_dir, name)
        os.makedirs(path, exist_ok=True)
        dirs[name] = os.path.abspath(path)
    return dirs


