def fmt_num(
    x: Any,
    decimals: int = 4,
    na_str: str = "N/A",
) -> str:
    """
    统一数字格式化，处理 NaN / inf / None 边界值。

    Parameters
    ----------
    x        : 待格式化数值
    decimals : 小数位数
    na_str   : NaN / None 时的替代字符串
    """
    if x is None:
        return na_str
    try:
        f = float(x)
    except (TypeError, ValueError):
        return str(x)
    if np.isnan(f):
        return na_str
    if np.isinf(f):
        return "∞" if f > 0 else "-∞"
    return f"{f:.{decimals}f}"


def arr_to_df(
    arr: np.ndarray,
    row_labels: Sequence[str],
    col_labels: Sequence[str],
    decimals: int = 4,
) -> pd.DataFrame:
    """
    将二维 numpy 数组转换为带行/列标签的 DataFrame（保留指定小数位）。

    Parameters
    ----------
    arr        : 二维数据数组，shape = (n_rows, n_cols)
    row_labels : 行标签列表
    col_labels : 列标签列表
    decimals   : 保留小数位数

    Returns
    -------
    pd.DataFrame : 格式化后的 DataFrame
    """
    return pd.DataFrame(
        np.round(arr, decimals),
        index=row_labels,
        columns=col_labels,
    )


def correlation_matrix(
    data_matrix: np.ndarray,
    indicator_names: List[str],
) -> Tuple[pd.DataFrame, List[Tuple[str, str, float]]]:
    """
    计算指标相关系数矩阵，并提取高相关指标对。

    Returns
    -------
    corr_df      : 相关系数 DataFrame
    high_corr    : 高相关对列表 [(ind_a, ind_b, r), ...]，|r| > 0.85
    """
    corr_df = pd.DataFrame(
        np.corrcoef(data_matrix.T),
        index=indicator_names,
        columns=indicator_names,
    )
    n = len(indicator_names)
    high_corr: List[Tuple[str, str, float]] = []
    for i in range(n):
        for j in range(i + 1, n):
            r = corr_df.iloc[i, j]
            if abs(r) > 0.85:
                high_corr.append((indicator_names[i], indicator_names[j], r))
    return corr_df, high_corr


def check_ahp_consistency(matrix: np.ndarray) -> Tuple[float, float, bool]:
    """
    检验 AHP 判断矩阵一致性。

    AHP 一致性指标 CI = (λ_max - n) / (n - 1)
    随机一致性比率 CR = CI / RI (RI 为平均随机一致性指数表)

    Parameters
    ----------
    matrix : n×n 正互反判断矩阵

    Returns
    -------
    ci     : 一致性指标
    cr     : 一致性比率（CR < 0.10 视为通过）
    passed : 是否通过一致性检验
    """
    # Saaty RI 表（n=1..15）
    ri_table = {
        1: 0.00, 2: 0.00, 3: 0.58, 4: 0.90, 5: 1.12,
        6: 1.24, 7: 1.32, 8: 1.41, 9: 1.45, 10: 1.49,
        11: 1.51, 12: 1.54, 13: 1.56, 14: 1.57, 15: 1.59,
    }
    n = matrix.shape[0]
    eigenvalues, _ = np.linalg.eig(matrix)
    lambda_max = float(np.max(eigenvalues.real))
    ci = (lambda_max - n) / max(n - 1, 1)
    ri = ri_table.get(n, 1.59)
    cr = ci / ri if ri > 0 else 0.0
    passed = cr < 0.10
    return ci, cr, passed


# ------------------------------------------------------------------
# ❽  安全数学工具（防止除零 / 奇异矩阵）
# ------------------------------------------------------------------

def safe_divide(
    numerator: np.ndarray,
    denominator: np.ndarray,
    fill_value: float = 0.0,
) -> np.ndarray:
    """
    安全除法，将分母为零的位置填充为 fill_value。
    用于归一化等操作防止 NaN / inf。
    """
    with np.errstate(divide="ignore", invalid="ignore"):
        result = np.where(
            np.abs(denominator) < 1e-12,
            fill_value,
            numerator / denominator,
        )
    return result


def normalize_weights(weights: np.ndarray) -> np.ndarray:
    """
    对权重向量进行归一化，确保 sum = 1.0。
    若输入全为零则返回均匀权重。
    """
    total = weights.sum()
    if total < 1e-12:
        n = len(weights)
        return np.full(n, 1.0 / n)
    return weights / total