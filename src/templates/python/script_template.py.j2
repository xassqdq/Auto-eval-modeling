# ================================================================
# 程序入口
# ================================================================

def main() -> None:
    """
    脚本入口函数。
    初始化日志 → 执行评价流水线 → 捕获异常并输出友好提示。
    """
    # 初始化日志
    logger = setup_logging(
        log_dir=os.path.join(OUTPUT_DIR, "logs"),
        verbose=VERBOSE,
    )

    print_section(
        f"AutoEval-Modeling  |  {{ meta.project_name }}"
        f"\n  生成时间: {{ meta.generated_at }}"
        f"\n  评价方法: {WEIGHT_METHOD.upper()} + {EVAL_MODEL.upper()}",
        char="█",
    )

    try:
        results = run_evaluation_pipeline(logger)
        logger.info("✅  评价流水线执行完成！")
    except FileNotFoundError as e:
        logger.error("数据文件未找到: %s", e)
        logger.error("请检查 DATA_FILE 配置: %s", DATA_FILE)
        sys.exit(1)
    except KeyError as e:
        logger.error("列名错误: %s", e)
        logger.error("请检查 EVAL_OBJECTS_COL 和 INDICATOR_COLS 配置")
        sys.exit(1)
    except np.linalg.LinAlgError as e:
        logger.error("矩阵计算错误（可能因矩阵奇异）: %s", e)
        logger.error("建议检查数据中是否存在完全相同的列或零方差指标")
        sys.exit(1)
    except Exception as e:
        logger.error("未预期的错误: %s", e)
        logger.debug(traceback.format_exc())
        sys.exit(1)


if __name__ == "__main__":
    main()