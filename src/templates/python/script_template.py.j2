    X_norm: np.ndarray,
    indicator_names: List[str],
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, pd.DataFrame]:
    """
    标准离差法：以各指标标准差的相对比例作为权重。

    适用场景：数据量足够且无需考虑指标间相关性时，
             作为熵权法的简化替代。
    """
    sigma = X_norm.std(axis=0, ddof=1)
    weights = normalize_weights(sigma)
    detail_df = pd.DataFrame({
        "指标":    indicator_names,
        "标准差":  np.round(sigma, 4),
        "权重 w":  np.round(weights, 6),
    })
    _log = logger.info if logger else print
    _log("\n  标准离差法计算完成:")
    print(detail_df.to_string(index=False))
    return weights, detail_df
{% endif %}


{% if use_ahp %}
def ahp_weight(
    matrix: np.ndarray,
    indicator_names: List[str],
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, float, float, bool]:
    """
    层次分析法（Analytic Hierarchy Process）主观赋权。

    方法：算术平均法求特征向量（近似权重）

    数学步骤
    --------
    1. 列归一化：a'_ij = a_ij / Σ_i(a_ij)
    2. 行平均：w_j = mean_i(a'_ij)（即特征向量近似）
    3. 计算最大特征值：λ_max = (1/n) Σ_j( (A·w)_j / w_j )
    4. 一致性检验：CI = (λ_max - n)/(n-1)，CR = CI/RI

    Parameters
    ----------
    matrix : n×n 正互反判断矩阵（满足 a_ij * a_ji = 1）

    Returns
    -------
    weights : 权重向量
    ci      : 一致性指标 CI
    cr      : 一致性比率 CR（< 0.10 视为可接受）
    passed  : 是否通过一致性检验
    """
    _log = logger.info if logger else print
    n = matrix.shape[0]

    # —— 列归一化 ——
    col_sums = matrix.sum(axis=0)
    norm_matrix = matrix / col_sums[np.newaxis, :]

    # —— 权重（行平均）——
    weights = norm_matrix.mean(axis=1)
    weights = normalize_weights(weights)

    # —— λ_max ——
    Aw = matrix @ weights
    lambda_vec = Aw / (weights + 1e-12)
    lambda_max = float(lambda_vec.mean())

    # —— 一致性检验 ——
    ci, cr, passed = check_ahp_consistency(matrix)

    _log(f"\n  AHP 判断矩阵维度: {n}×{n}")
    _log(f"  λ_max = {lambda_max:.4f}")
    _log(f"  CI = {ci:.4f},  CR = {cr:.4f}  {'✅ 通过' if passed else '⚠️  未通过（CR≥0.10）'}")
    if not passed:
        _log("  建议: 请检查判断矩阵的内部一致性，调整专家打分")

    print_weights_table(weights, indicator_names, "AHP层次分析法")
    return weights, ci, cr, passed
{% endif %}


{% if use_combination_weights %}
def combine_weights(
    weights_list: List[np.ndarray],
    method_names: List[str],
    coef: Optional[List[float]] = None,
    method: str = "linear",
    logger: Optional[logging.Logger] = None,
) -> Tuple[np.ndarray, pd.DataFrame]:
    """
    组合赋权：将多个权重向量合成一组综合权重。

    合成方法
    --------
    linear         : 线性加权 w = Σ α_k · w_k
    multiplicative : 乘法合成 w_j = Π(w_kj^α_k)，再归一化
    min_deviation  : 基于最小偏差原则，最小化各单一权重与组合权重的加权偏差

    Parameters
    ----------
    weights_list : 多个单一权重向量的列表
    method_names : 各权重向量对应的方法名称（用于表格展示）
    coef         : 合成系数（各权重的重要程度）；None → 等权合成
    method       : 合成方法

    Returns
    -------
    combined     : 组合权重向量
    compare_df   : 各方法权重对比 DataFrame
    """
    _log = logger.info if logger else print
    K = len(weights_list)
    n = len(weights_list[0])

    if coef is None:
        coef = [1.0 / K] * K
    alpha = np.array(coef, dtype=float)
    alpha /= alpha.sum()  # 确保系数归一化

    if method == "linear":
        W = np.array(weights_list)       # shape (K, n)
        combined = alpha @ W             # shape (n,)

    elif method == "multiplicative":
        log_W = np.array([np.log(w + 1e-12) for w in weights_list])
        combined = np.exp(alpha @ log_W)

    elif method == "min_deviation":
        # 基于离差最小化模型（闭式解）：
        # min Σ_k Σ_j (w_j - w_kj)^2
        # 等价于取各方法权重的等权平均（无监督时）
        combined = np.array(weights_list).mean(axis=0)

    else:
        raise ValueError(f"不支持的组合方法: '{method}'")

    combined = normalize_weights(combined)

    # —— 对比表格 ——
    rows = {}
    for k, (w, name) in enumerate(zip(weights_list, method_names)):
        rows[name] = np.round(w, 6)
    rows["组合权重"] = np.round(combined, 6)
    compare_df = pd.DataFrame(rows).T
    compare_df.columns = [f"指标{i+1}" for i in range(n)]

    _log(f"\n  组合赋权完成（{method}）:")
    print(compare_df.to_string())
    return combined, compare_df
{% endif %}


